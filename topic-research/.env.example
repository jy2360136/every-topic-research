# MiniMax API Key (必填)
MINIMAX_API_KEY=your-minimax-key-here

# 可选：自定义 API 地址
MINIMAX_API_URL=https://api.minimaxi.com/anthropic/v1/messages

# 可选：自定义模型名
MINIMAX_MODEL=MiniMax-M3

# 可选：B站搜索最大候选数
BILI_CANDIDATE_LIMIT=60

# 可选：每个主题同时处理的并发数
TOPIC_CONCURRENCY=2

# 可选：时长过滤下限（秒，默认 300 = 5 分钟）
BILI_MIN_DURATION=300

# 可选：时长过滤上限（秒，默认 2400 = 40 分钟）
BILI_MAX_DURATION=2400

# 可选：B 站登录 cookie 里的 SESSDATA。
# 不填则 player/v2 接口的 subtitles 列表始终为空（need_login_subtitle=true）。
# 浏览器登录 B 站后从 devtools 复制：document.cookie 中 SESSDATA=xxx 部分的值。
BILI_SESSDATA=your-sessdata-here